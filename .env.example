APP_NAME="Sograte"
APP_ENV=local # set to 'production' for live
APP_KEY=
APP_DEBUG=true # set to false for production
APP_URL=http://localhost:8000 # set to canonical HTTPS URL

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack # 'daily' recommended for production
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sogratejerky
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=sograte_session
SESSION_SECURE_COOKIE=false # set to true for HTTPS production

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
DB_QUEUE=sograte

CACHE_STORE=database
CACHE_PREFIX=sograte-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=sograte-database-

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Commerce / Stripe
CHECKOUT_ENABLED=true
ALLOW_PRODUCTION_CHECKOUT=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Optional: test-mode secret key used only for read-only verification of historical test orders.
STRIPE_TEST_SECRET=
# STRIPE_API_VERSION=2026-10-28.endive
# Webhook endpoint: https://your-production-domain.example/stripe/webhook

# One-time administrator seeding (use only for php artisan db:seed --class=AdminUserSeeder)
# ADMIN_SEED_NAME=
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups
BACKUP_NAME=Sograte
# Use "backups" for local private storage, or "backups,s3" for local plus off-site S3.
BACKUP_DISKS=backups
BACKUP_NOTIFICATION_EMAIL=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_ENCRYPTION=default
BACKUP_MAX_STORAGE_MB=5000
BACKUP_FOLLOW_LINKS=false
# Optional path to mysqldump when it is not on the PHP process PATH.
DB_DUMP_BINARY_PATH=

VITE_APP_NAME="${APP_NAME}"
